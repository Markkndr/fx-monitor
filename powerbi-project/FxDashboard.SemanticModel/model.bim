          }
        ],
        "partitions": [
          {
            "name": "Allocation",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Excel.Workbook(File.Contents(\"C:\\Projects\\PortfolioProjects\\currency-exchange-platform\\powerbi-exports\\fx-compliant.xlsx\"), null, true),",
                "    Data = Source{[Item=\"Portfolio Summary\", Kind=\"Sheet\"]}[Data],",
                "    NoBlanks = Table.SelectRows(Data, each not List.IsEmpty(List.RemoveMatchingItems(Record.FieldValues(_), {null, \"\"}))),",
                "    Skipped = Table.Skip(NoBlanks, 3),",
                "    Promoted = Table.PromoteHeaders(Skipped, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"Currency\", type text}, {\"Net exposure\", type number}, {\"Reserved\", type number}, {\"Rate to home\", type number}, {\"Value in home\", type number}, {\"% of portfolio\", type number}})",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
