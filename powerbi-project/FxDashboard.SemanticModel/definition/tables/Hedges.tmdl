table Hedges
	lineageTag: 21cd2a24-4b53-4a06-b862-507356bff1c9

	measure 'Total Notional' = SUM ( Hedges[Notional] )
		formatString: #,0.00
		lineageTag: 8c6dede7-8a88-49c0-b931-13cf02541de1

	measure 'Total Unrealized P&L' = SUM ( Hedges[Unrealized P&L] )
		formatString: #,0.00
		lineageTag: cbc0348a-d029-4740-a45f-528a04e479e9

	measure 'Avg Hedge Ratio %' = AVERAGE ( Hedges[Hedge ratio %] )
		formatString: 0.00
		lineageTag: e4eefe6b-bfe0-4b50-9b21-8ac48215d09e

	measure 'Avg Effectiveness %' = AVERAGE ( Hedges[Effectiveness %] )
		formatString: 0.00
		lineageTag: 82c68f62-0d68-41bc-a81d-331a658a6027

	measure 'Designated Hedges' = CALCULATE ( COUNTROWS ( Hedges ), NOT ISBLANK ( Hedges[Exposure ID] ) )
		formatString: 0
		lineageTag: 5db18c00-1fbb-4eb3-bf68-10a73816731c

	measure 'Assessed Hedges' =
			CALCULATE (
			    COUNTROWS ( Hedges ),
			    NOT ISBLANK ( Hedges[Exposure ID] ),
			    NOT ISBLANK ( Hedges[Effectiveness %] )
			)
		formatString: 0
		lineageTag: 1bc3bf09-773f-419c-aae7-3ecbcf9d6bbc

	measure 'Passing Hedges' =
			CALCULATE (
			    COUNTROWS ( Hedges ),
			    FILTER (
			        Hedges,
			        NOT ISBLANK ( Hedges[Exposure ID] )
			            && NOT ISBLANK ( Hedges[Effectiveness %] )
			            && ABS ( Hedges[Effectiveness %] ) >= 80
			            && ABS ( Hedges[Effectiveness %] ) <= 125
			    )
			)
		formatString: 0
		lineageTag: 2e4fd4e1-6a24-4a8d-aca8-e0734dff66ff

	measure 'Failing Hedges' =
			CALCULATE (
			    COUNTROWS ( Hedges ),
			    FILTER (
			        Hedges,
			        NOT ISBLANK ( Hedges[Exposure ID] )
			            && NOT ISBLANK ( Hedges[Effectiveness %] )
			            && ( ABS ( Hedges[Effectiveness %] ) < 80 || ABS ( Hedges[Effectiveness %] ) > 125 )
			    )
			)
		formatString: 0
		lineageTag: 6d0bab45-f438-4a67-9f40-4ef8b77abd24

	measure 'Not Assessable Hedges' =
			CALCULATE (
			    COUNTROWS ( Hedges ),
			    FILTER ( Hedges, NOT ISBLANK ( Hedges[Exposure ID] ) && ISBLANK ( Hedges[Effectiveness %] ) )
			)
		formatString: 0
		lineageTag: 7a86efd4-d069-4c6b-a9fa-f33724dbd267

	measure 'Pass Rate %' = DIVIDE ( [Passing Hedges], [Assessed Hedges] )
		formatString: 0.0%
		lineageTag: 61de2043-dcd0-4b06-a4f0-a687d36e9f8d

	measure 'Compliance Status' =
			VAR assessed = [Assessed Hedges]
			VAR fail = [Failing Hedges]
			RETURN
			SWITCH (
			    TRUE (),
			    assessed = 0, "NO ASSESSABLE HEDGES",
			    fail = 0, "COMPLIANT — all assessed hedges highly effective",
			    "REVIEW REQUIRED — " & fail & " hedge(s) outside the effective band"
			)
		lineageTag: ea5c9989-e75f-460a-9afb-eab454cb3f5d

	measure 'Compliance Status Color' =
			SWITCH (
			    TRUE (),
			    [Assessed Hedges] = 0, "#6B7280",
			    [Failing Hedges] = 0, "#1B7A3D",
			    "#B02A2A"
			)
		lineageTag: e634e6d0-978c-4f22-a549-b4aaabf7c373

