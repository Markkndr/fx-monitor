	column Verdict =
			VAR eff = Hedges[Effectiveness %]
			RETURN
			SWITCH (
			    TRUE (),
			    ISBLANK ( Hedges[Exposure ID] ), "Economic",
			    ISBLANK ( eff ), "N/A",
			    ABS ( eff ) >= 80 && ABS ( eff ) <= 125, "PASS",
			    "FAIL"
			)
		dataType: string
		lineageTag: 781464d6-338c-4768-b8c5-96d3fe391d89
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Account
		dataType: string
		lineageTag: aa077d90-dc7d-45f2-b9e9-1a74575c97e2
		summarizeBy: none
		sourceColumn: Account

	partition Hedges = m
		mode: import
		source =
				let
				    Load = (path as text, account as text) =>
				        let
				            Source = Excel.Workbook(File.Contents(path), null, true),
				            Data = Source{[Item="Hedges", Kind="Sheet"]}[Data],
				            Promoted = Table.PromoteHeaders(Data, [PromoteAllScalars=true]),
				            Tagged = Table.AddColumn(Promoted, "Account", each account, type text)
				        in
				            Tagged,
				    Combined = Table.Combine({
				        Load("C:\Projects\PortfolioProjects\currency-exchange-platform\powerbi-exports\fx-compliant.xlsx", "Compliant"),
				        Load("C:\Projects\PortfolioProjects\currency-exchange-platform\powerbi-exports\fx-mid.xlsx", "Mid"),
				        Load("C:\Projects\PortfolioProjects\currency-exchange-platform\powerbi-exports\fx-breach.xlsx", "Breach")
				    }),
				    Typed = Table.TransformColumnTypes(Combined, {{"ID", Int64.Type}, {"Exposure ID", Int64.Type}, {"Notional", type number}, {"Contract rate", type number}, {"Spot rate", type number}, {"Mark-to-market", type number}, {"Unrealized P&L", type number}, {"Hedge ratio %", type number}, {"Effectiveness %", type number}, {"Maturity date", type datetime}})
				in
				    Typed

