spring:
  application:
    name: currency-exchange-platform

  datasource:
    url: jdbc:h2:file:${user.home}/.fx-monitor/data/fxmonitor;AUTO_SERVER=TRUE
    driver-class-name: org.h2.Driver
    username: sa
    password:

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: false
    properties:
      hibernate:
        dialect: org.hibernate.dialect.H2Dialect
        format_sql: true

  cache:
    type: simple

  security:
    jwt:
      secret: ${JWT_SECRET:dev-only-insecure-secret-change-me-make-it-long-and-secure-at-least-256-bits}
      expiration: 900000
      refresh-expiration: 604800000

server:
  port: 8080

forex:
  api:
    url: https://api.exchangerate-api.com/v4/latest
    key: ${FOREX_API_KEY:}
    update-interval: 3600
    timeout: 5000
  snapshot:
    base: USD
    currencies: EUR,GBP,JPY,CNY,CHF,CAD,AUD
    interval: 3600
  alert:
    # How often (seconds) active rate alerts are re-evaluated against live quotes.
    interval: 900

# Platform Fee Configuration
platform:
  fees:
    exchange-percentage: 0.5
    transfer-percentage: 0.1
    withdrawal-percentage: 0.2
    min-exchange-amount: 1.00
    max-daily-exchange: 10000.00

logging:
  level:
    com.currencyexchange: DEBUG
    org.springframework.security: DEBUG
    org.springframework.web: INFO
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss} - %msg%n"